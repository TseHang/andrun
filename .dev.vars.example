# Copy to .dev.vars (git-ignored). Used by `pnpm dev` (wrangler dev).
# For a zero-cost local run, start `pnpm fake-model` and use the two lines below as they are.
AIAND_API_KEY=fake
AIAND_BASE_URL=http://localhost:8788

# GitHub: a local run talks to the fake GitHub (`pnpm fake-github`, port 8789), never the real one.
GITHUB_API_URL=http://localhost:8789
GITHUB_APP_ID=1
GITHUB_APP_INSTALLATION_ID=1
GITHUB_PAT=github_pat_fake
# A throwaway key, generated only for this file. It is only ever used against the fake GitHub
# and has no access to anything. Do not put a real App key here.
