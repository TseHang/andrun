{
  "name": "andrun",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint --no-error-on-unmatched-pattern src eval test web e2e",
    "eval": "tsx eval/run.ts",
    "build": "vite build",
    "dev": "wrangler dev",
    "dev:web": "vite",
    "e2e": "playwright test",
    "deploy": "vite build && wrangler deploy",
    "fake-model": "tsx test/support/fake-sse-server.ts",
    "smoke": "tsx test/support/smoke.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.2",
    "wrangler": "4.144.0"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  }
}
