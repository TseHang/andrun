{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "eval",
    "test",
    "*.config.ts"
  ],
  "exclude": [
    "src/worker/index.ts",
    "src/worker/env.ts",
    "src/worker/session-do.ts",
    "src/worker/workspace-do.ts"
  ]
}
